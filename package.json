{
  "name": "@motifx-community/ui",
  "version": "0.0.0",
  "description": "UI components for MotifJS (@motifx/core) on the MotifJS design system",
  "keywords": [
    "motifjs",
    "motifx",
    "motif",
    "ui",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/motifjs-community/motifjs-ui"
  },
  "homepage": "https://motifjs.com/docs/ui",
  "bugs": {
    "url": "https://github.com/motifjs-community/motifjs-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite apps/docs --port 4500",
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "docs:build": "npm run tokens && vite build apps/docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:jsx": "motif-lint",
    "lint:css": "stylelint \"src/**/*.css\" \"apps/docs/**/*.css\"",
    "sizes": "node scripts/sizes.mjs",
    "e2e": "node e2e/docs-smoke.mjs",
    "check": "npm run typecheck && npm run lint:jsx && npm run lint:css && npm test && npm run build && npm run docs:build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@motifx-community/design-system": "0.x",
    "@motifx/core": "^1.2.0-rc.19",
    "@motifx-community/data": "0.x"
  },
  "devDependencies": {
    "@motifx-community/data": "file:../motifjs-data",
    "@motifx-community/design-system": "file:../motifjs-design-system",
    "@motifx/compiler": "1.2.0-rc.19",
    "@motifx/core": "1.2.0-rc.19",
    "@types/node": "^24.19.1",
    "axe-core": "^4.11.0",
    "jsdom": "^30.1.2",
    "style-dictionary": "^5.6.1",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
