{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "noImplicitOverride": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@motifx-community/ui": ["./src/index.ts"],
      "@motifx-community/ui/tokens": ["./src/tokens/index.ts"],
      "@motifx-community/ui/excel": ["./src/excel/index.ts"],
      "@motifx-community/ui/pdf": ["./src/pdf/index.ts"]
    }
  },
  "include": ["src", "tests", "apps/docs", "vite.config.ts"]
}
