{
  "tabs": {
    "pill-gap": { "$value": "0px" },
    "curve-display": { "$value": "none" },
    "curve-size": { "$value": "0px" },
    "curve-frame-width": { "$value": "0px" },
    "curve-frame-color": { "$value": "{color.stroke.card}" },
    "tab-overlap": { "$value": "0px" },
    "indicator-offset": { "$value": "0px" },
    "indicator-inset-vertical": { "$value": "calc(50% - 0.5rem)" },
    "close-pull": { "$value": 0.5 },
    "scroll-back-rotate": { "$value": {"value": 90, "unit": "deg"} },
    "scroll-forward-rotate": { "$value": {"value": -90, "unit": "deg"} },
    "scroll-up-rotate": { "$value": {"value": 180, "unit": "deg"} },
    "scroll-down-rotate": { "$value": {"value": 0, "unit": "deg"} },
    "vertical-width": { "$value": {"value": 10, "unit": "rem"} },
    "font-size": {
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "line-height": {
      "sm": { "$value": "{font.line.caption}" },
      "md": { "$value": "{font.line.body}" },
      "lg": { "$value": "{font.line.body-large}" }
    },
    "height": {
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": {"value": 2.25, "unit": "rem"} },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{space.3}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "indicator-inset": {
      "sm": { "$value": "calc(50% - 0.5rem)" },
      "md": { "$value": "calc(50% - 0.5rem)" },
      "lg": { "$value": "calc(50% - 0.5rem)" }
    },
    "pill-height": {
      "sm": { "$value": "{tabs.height.sm}" },
      "md": { "$value": "{tabs.height.md}" },
      "lg": { "$value": "{tabs.height.lg}" }
    },
    "container": {
      "color": { "$value": "{color.fg.primary}" }
    },
    "scroll": {
      "min-width": { "$value": "{control.height.sm}" },
      "min-height": { "$value": "{control.height.sm}" },
      "radius": { "$value": "{radius.md}" },
      "color": { "$value": "{color.fg.secondary}" },
      "hover": {
        "bg": { "$value": "{color.fill.subtle.secondary}" },
        "color": { "$value": "{color.fg.primary}" }
      },
      "pressed": {
        "bg": { "$value": "{color.fill.subtle.secondary}" },
        "color": { "$value": "{color.fg.primary}" }
      },
      "end": {
        "color": { "$value": "{color.fg.disabled}" }
      }
    },
    "scroll-icon": {
      "size": { "$value": "{glyph.size}" },
      "icon": { "$value": "chevron-down" }
    },
    "tab": {
      "gap": { "$value": "{control.gap}" },
      "radius": { "$value": "{radius.md}" },
      "color": { "$value": "{color.fg.primary}" },
      "font-weight": { "$value": "{font.weight.regular}" },
      "pill": {
        "radius": { "$value": "8px" },
        "radius-bottom": { "$value": "0px" }
      },
      "hover": {
        "color": { "$value": "{color.fg.secondary}" }
      },
      "pill-hover": {
        "bg": { "$value": "{color.fill.subtle.secondary}" }
      },
      "pressed": {
        "color": { "$value": "{color.fg.tertiary}" }
      },
      "pill-pressed": {
        "bg": { "$value": "{color.fill.subtle.tertiary}" }
      },
      "selected": {
        "color": { "$value": "{color.fg.primary}" }
      },
      "pill-selected": {
        "bg": { "$value": "{color.bg.layer}" },
        "shadow": { "$value": {"color": "{color.bg.layer}", "offsetX": "0px", "offsetY": "calc({border.width.1} * -1)", "blur": "0px", "spread": "0px", "inset": true} },
        "glow": { "$value": {"color": "{color.stroke.card}", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "{border.width.1}", "inset": true} }
      },
      "disabled": {
        "color": { "$value": "{color.fg.disabled}" }
      },
      "focus": {
        "glow": { "$value": "{focus.ring.halo-inset}" },
        "outline-width": { "$value": "{focus.ring.width}" },
        "outline-color": { "$value": "{focus.ring.color}" },
        "outline-offset": { "$value": "calc({focus.ring.width} * -1)" }
      }
    },
    "icon": {
      "size": { "$value": "{icon.size.md}" }
    },
    "badge": {
      "height": { "$value": "{icon.size.md}" },
      "min-width": { "$value": "{icon.size.md}" },
      "padding-inline": { "$value": "{space.1}" },
      "bg": { "$value": "{color.fill.subtle.tertiary}" },
      "radius": { "$value": "{radius.full}" },
      "color": { "$value": "{color.fg.primary}" },
      "font-size": { "$value": "{font.size.caption}" },
      "line-height": { "$value": 1 },
      "pill-selected": {
        "bg": { "$value": "{color.accent.solid}" },
        "color": { "$value": "{color.accent.on-solid}" }
      }
    },
    "close": {
      "size": { "$value": "{icon.size.md}" },
      "radius": { "$value": "{radius.sm}" },
      "color": { "$value": "{color.fg.secondary}" },
      "hover": {
        "bg": { "$value": "{color.fill.subtle.secondary}" },
        "color": { "$value": "{color.fg.primary}" }
      },
      "pressed": {
        "bg": { "$value": "{color.fill.subtle.tertiary}" },
        "color": { "$value": "{color.fg.primary}" }
      },
      "disabled": {
        "bg": { "$value": {"colorSpace": "srgb", "components": [0,0,0], "alpha": 0} },
        "color": { "$value": "{color.fg.disabled}" }
      }
    },
    "close-icon": {
      "size": { "$value": "{glyph.size}" },
      "icon": { "$value": "dismiss" }
    },
    "indicator": {
      "height": { "$value": "{indicator.thickness}" },
      "radius": { "$value": "{indicator.radius}" },
      "radius-bottom": { "$value": "{indicator.radius}" },
      "vertical": {
        "width": { "$value": "{indicator.thickness}" },
        "height": { "$value": "auto" }
      },
      "selected": {
        "bg": { "$value": "{color.accent.solid}" }
      },
      "selected-disabled": {
        "bg": { "$value": "{color.fg.disabled}" }
      }
    },
    "panel": {
      "padding": { "$value": "{space.4}" },
      "bg": { "$value": "{color.bg.layer}" },
      "radius-bottom": { "$value": "8px" },
      "pill-across": {
        "padding-inline": { "$value": "{space.4}" }
      },
      "focus": {
        "glow": { "$value": "{focus.ring.halo}" },
        "outline-width": { "$value": "{focus.ring.width}" },
        "outline-color": { "$value": "{focus.ring.color}" },
        "outline-offset": { "$value": "{focus.ring.offset}" }
      }
    }
  }
}
