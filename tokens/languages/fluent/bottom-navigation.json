{
  "bottom-navigation": {
    "bar": {
      "bg": {
        "$value": "{color.bg.bar}"
      },
      "border-top-width": {
        "$value": "{border.width.1}"
      },
      "border-color": {
        "$value": "{color.stroke.divider}"
      },
      "shadow": {
        "$value": "none"
      }
    },
    "list": {
      "min-height": {
        "$value": {
          "value": 56,
          "unit": "px"
        }
      },
      "padding-block": {
        "$value": "{space.1}"
      },
      "padding-inline": {
        "$value": "{space.1}"
      },
      "gap": {
        "$value": "{space.1}"
      }
    },
    "item": {
      "color": {
        "$value": "{color.fg.secondary}"
      },
      "gap": {
        "$value": "{space.0}"
      },
      "radius": {
        "$value": "{radius.md}"
      },
      "padding-block": {
        "$value": "{space.1}"
      },
      "hover": {
        "color": {
          "$value": "{color.fg.primary}"
        }
      },
      "focus": {
        "glow": {
          "$value": "{focus.ring.halo}"
        },
        "outline-width": {
          "$value": "{focus.ring.width}"
        },
        "outline-color": {
          "$value": "{focus.ring.color}"
        },
        "outline-offset": {
          "$value": "{focus.ring.offset}"
        }
      },
      "selected": {
        "color": {
          "$value": "{color.accent.fg}"
        }
      },
      "disabled": {
        "color": {
          "$value": "{color.fg.disabled}"
        }
      }
    },
    "indicator": {
      "width": {
        "$value": "{indicator.length}"
      },
      "height": {
        "$value": "{indicator.thickness}"
      },
      "radius": {
        "$value": "{indicator.radius}"
      },
      "bg": {
        "$value": "{color.selection.indicator}"
      },
      "margin-top": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "selected": {
        "opacity": {
          "$value": 1
        }
      }
    },
    "icon-host": {
      "size": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    },
    "label": {
      "font-size": {
        "$value": "{font.size.caption}"
      },
      "font-weight": {
        "$value": "{font.weight.medium}"
      },
      "line-height": {
        "$value": "{font.line.caption}"
      },
      "letter-spacing": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "selected": {
        "font-weight": {
          "$value": "{font.weight.semibold}"
        }
      }
    }
  }
}
