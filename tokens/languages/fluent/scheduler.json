      "focus": {
        "glow": { "$value": "{focus.ring.halo-inset}" },
        "outline-width": { "$value": "{focus.ring.width}" },
        "outline-color": { "$value": "{focus.ring.color}" },
        "outline-offset": { "$value": "calc(-1 * {focus.ring.width})" }
      },
      "past": {
        "color": { "$value": "{color.fg.secondary}" }
      },
      "disabled": {
        "opacity": { "$value": "{opacity.disabled}" }
      }
    },
    "agenda-content": {
      "gap": { "$value": "{space.2}" }
    },
    "agenda-time": {
      "color": { "$value": "{color.fg.secondary}" },
      "font-size": { "$value": "{font.size.caption}" }
    },
    "agenda-dot": {
      "display": { "$value": "block" },
      "width": { "$value": {"value": 0.25, "unit": "rem"} },
      "height": { "$value": {"value": 1.25, "unit": "rem"} },
      "radius": { "$value": "{radius.sm}" }
    },
    "agenda-text": {
      "color": { "$value": "{color.fg.primary}" },
      "font-size": { "$value": "{font.size.body}" },
      "font-weight": { "$value": "{font.weight.regular}" }
    },
    "agenda-empty": {
      "padding": { "$value": "{space.6}" },
      "color": { "$value": "{color.fg.secondary}" },
      "font-size": { "$value": "{font.size.body}" }
    }
  }
}
