{
  "qr-code": {
    "size": {
      "$value": {
        "value": 144,
        "unit": "px"
      }
    },
    "sheet": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 1
        }
      },
      "color": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 1
        }
      },
      "radius": {
        "$value": "{radius.md}"
      }
    },
    "logo": {
      "radius": {
        "$value": "{radius.xs}"
      },
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 1
        }
      }
    }
  }
}
