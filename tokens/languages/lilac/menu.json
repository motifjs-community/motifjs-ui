        "outline-offset": { "$value": "{focus.ring.offset}" }
      },
      "disabled": {
        "color": { "$value": "{color.fg.disabled}" }
      },
      "accent": {
        "color": { "$value": "{color.accent.fg}" }
      },
      "success": {
        "color": { "$value": "{color.success.fg}" }
      },
      "caution": {
        "color": { "$value": "{color.caution.fg}" }
      },
      "danger": {
        "color": { "$value": "{color.danger.fg}" }
      }
    },
    "check": {
      "size": { "$value": "{icon.size.md}" }
    },
    "icon": {
      "size": { "$value": "{icon.size.md}" },
      "accent": {
        "color": { "$value": "{color.accent.fg}" }
      },
      "success": {
        "color": { "$value": "{color.success.fg}" }
      },
      "caution": {
        "color": { "$value": "{color.caution.fg}" }
      },
      "danger": {
        "color": { "$value": "{color.danger.fg}" }
      }
    },
    "check-mark": {
      "icon": { "$value": "check" }
