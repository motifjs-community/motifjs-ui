{
  "button-group": {
    "attached": {
      "$value": "true"
    },
    "gap": {
      "$value": "{space.2}"
    },
    "item": {
      "variant": {
        "$value": "outline"
      },
      "face": {
        "toggled": {
          "bg": {
            "$value": "{color.accent.subtle}"
          },
          "color": {
            "$value": "{color.accent.on-subtle}"
          }
        },
        "toggled-hover": {
          "bg": {
            "$value": "{color.accent.subtle}"
          }
        },
        "outline-toggled": {
          "bg": {
            "$value": "{color.accent.subtle}"
          },
          "color": {
            "$value": "{color.accent.on-subtle}"
          },
          "border-color": {
            "$value": "{button.face.outline-toggled.border-color}"
          }
        },
        "outline-toggled-hover": {
          "bg": {
            "$value": "{color.accent.subtle}"
          }
        },
        "ghost-toggled": {
          "bg": {
            "$value": "{color.accent.subtle}"
          },
          "color": {
            "$value": "{color.accent.on-subtle}"
          }
        },
        "ghost-toggled-hover": {
          "bg": {
            "$value": "{color.accent.subtle}"
          }
        }
      }
    },
    "inner-start": {
      "face": {
        "radius-start": {
          "$value": "{radius.none}"
        }
      }
    },
    "inner-end": {
      "face": {
        "radius-end": {
          "$value": "{radius.none}"
        }
      }
    }
  }
}
