{
  "number-box": {
    "spin-layout": { "$value": "stacked" },
    "spin-order": { "$value": "down-up" },
    "spin-inset": { "$value": "{border.width.2}" },
    "step": {
      "stacked": {
        "min-width": { "$value": "{space.5}" },
        "padding-inline": { "$value": "0px" }
      }
    },
    "glyph": {
      "up": {
        "icon": { "$value": "chevron-up" }
      },
      "down": {
        "icon": { "$value": "chevron-down" }
      },
      "inline-up": {
        "icon": { "$value": "plus" }
      },
      "inline-down": {
        "icon": { "$value": "dash" }
      },
      "stacked": {
        "max-height": { "$value": "{icon.size.sm}" }
      }
    }
  }
}
