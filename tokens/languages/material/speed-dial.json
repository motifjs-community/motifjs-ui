{
  "speed-dial": {
    "inset": {
      "$value": "{space.6}"
    },
    "gap": {
      "$value": "{space.3}"
    },
    "label-gap": {
      "$value": "{space.3}"
    },
    "main": {
      "size": {
        "$value": {
          "value": 3.5,
          "unit": "rem"
        }
      },
      "radius": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "bg": {
        "$value": "{color.accent.subtle}"
      },
      "color": {
        "$value": "{color.accent.fg}"
      },
      "shadow": {
        "$value": "{elevation.card}"
      },
      "gap": {
        "$value": "{space.2}"
      },
      "hover": {
        "bg": {
          "$value": "{color.accent.subtle}"
        },
        "cursor": {
          "$value": "pointer"
        }
      },
      "pressed": {
        "bg": {
          "$value": "{color.accent.subtle}"
        }
      },
      "focus": {
        "glow": {
          "$value": "{focus.ring.halo}"
        },
        "outline-width": {
          "$value": "{focus.ring.width}"
        },
        "outline-color": {
          "$value": "{focus.ring.color}"
        },
        "outline-offset": {
          "$value": "{focus.ring.offset}"
        }
      },
      "disabled": {
        "opacity": {
          "$value": "{opacity.disabled}"
        }
      },
      "extended": {
        "width": {
          "$value": "auto"
        },
        "padding": {
          "$value": "{space.4}"
        }
      }
    },
    "main-glyph": {
      "size": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "bg": {
        "$value": "{color.accent.fg}"
      }
    },
    "main-text": {
      "font-weight": {
        "$value": "{font.weight.semibold}"
      }
    },
    "action": {
      "size": {
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      },
      "radius": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "bg": {
        "$value": "{color.bg.surface}"
      },
      "color": {
        "$value": "{color.fg.primary}"
      },
      "hover": {
        "bg": {
          "$value": "{color.fill.control.secondary}"
        },
        "cursor": {
          "$value": "pointer"
        }
      },
      "pressed": {
        "bg": {
          "$value": "{color.fill.control.tertiary}"
        }
      },
      "focus": {
        "glow": {
          "$value": "{focus.ring.halo}"
        },
        "outline-width": {
          "$value": "{focus.ring.width}"
        },
        "outline-color": {
          "$value": "{focus.ring.color}"
        },
        "outline-offset": {
          "$value": "{focus.ring.offset}"
        }
      },
      "disabled": {
        "opacity": {
          "$value": "{opacity.disabled}"
        }
      },
      "shadow": {
        "$value": "{elevation.card}"
      }
    },
    "action-icon": {
      "size": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "bg": {
        "$value": "{color.fg.primary}"
      }
    },
    "label": {
      "bg": {
        "$value": "{color.bg.surface}"
      },
      "color": {
        "$value": "{color.fg.primary}"
      },
      "radius": {
        "$value": "{radius.sm}"
      },
      "padding": {
        "$value": "{space.2}"
      },
      "font-size": {
        "$value": "{font.size.caption}"
      },
      "shadow": {
        "$value": "{elevation.card}"
      }
    }
  }
}
