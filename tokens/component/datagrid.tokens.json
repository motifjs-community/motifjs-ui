{
  "datagrid": {
    "$description": "DataGrid: rows sized by the density tokens, a bar header, row tints for hover, the active row, selected and new rows and stripes, the marks of unsaved and invalid cells, the selection check boxes, the action buttons, the filter row, the header filter window, the text the search found, the group rows and the group panel's chips.",
    "row-height": { "$type": "dimension", "$value": "{control.height.md}" },
    "row-padding": { "$type": "dimension", "$value": "{space.1}" },
    "cell-padding": { "$type": "dimension", "$value": "{control.padding.sm}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.body}" },
    "head-font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "bar-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "bar-gap": { "$type": "dimension", "$value": "{space.3}" },
    "bar-padding": { "$type": "dimension", "$value": "{space.2}" },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.sm}" },
    "button-size": { "$type": "dimension", "$value": "{control.height.sm}" },
    "resize-width": { "$type": "dimension", "$value": "{space.2}" },
    "mark-size": { "$type": "dimension", "$value": "{space.2}" },
    "invalid-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "background": { "$type": "color", "$value": "{color.bg.surface}" },
    "head-background": { "$type": "color", "$value": "{color.bg.bar}" },
    "head-color": { "$type": "color", "$value": "{color.fg.secondary}" },
    "line-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "outline-color": { "$type": "color", "$value": "{color.stroke.card}" },
    "edge-color": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "stripe": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "active": { "$type": "color", "$value": "{color.accent.subtle}" },
    "new": { "$type": "color", "$value": "{color.success.subtle}" },
    "changed": { "$type": "color", "$value": "{color.accent.solid}" },
    "invalid": { "$type": "color", "$value": "{color.danger.solid}" },
    "placeholder": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "selected": { "$type": "color", "$value": "{color.accent.subtle}" },
    "check-size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
    "check-mark-size": { "$type": "dimension", "$value": "{icon.size.sm}" },
    "check-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "action-gap": { "$type": "dimension", "$value": "{space.1}" },
    "filter-padding": { "$type": "dimension", "$value": "{space.1}" },
    "values-width": { "$type": "dimension", "$value": { "value": 16, "unit": "rem" } },
    "values-gap": { "$type": "dimension", "$value": "{space.2}" },
    "search-mark-background": { "$type": "color", "$value": "{color.caution.subtle}" },
    "search-mark-color": { "$type": "color", "$value": "{color.fg.primary}" },
    "search-mark-line": { "$type": "color", "$value": "{color.caution.fg}" },
    "group-indent": { "$type": "dimension", "$value": "{space.5}" },
    "group-font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "group-background": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "group-count-color": { "$type": "color", "$value": "{color.fg.secondary}" },
    "chip-gap": { "$type": "dimension", "$value": "{space.1}" },
    "chip-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "chip-background": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "chip-border-color": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "panel-empty-color": { "$type": "color", "$value": "{color.fg.secondary}" },
    "drop-target": { "$type": "color", "$value": "{color.accent.subtle}" },
    "drop-ready": { "$type": "color", "$value": "{color.accent.solid}" },
    "ghost-border-color": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "ghost-target-color": { "$type": "color", "$value": "{color.accent.solid}" },
    "ghost-shadow": { "$type": "shadow", "$value": "{shadow.8}" }
  }
}
