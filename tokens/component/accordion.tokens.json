{
  "accordion": {
    "$description": "Accordion: headers that open and close their sections, sized by the density tokens.",
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "gap": { "$type": "dimension", "$value": "{control.gap}" },
    "card-gap": { "$type": "dimension", "$value": "{space.2}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "content-padding": { "$type": "dimension", "$value": "{space.4}" },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "line-height": {
      "$type": "dimension",
      "sm": { "$value": "{font.line.caption}" },
      "md": { "$value": "{font.line.body}" },
      "lg": { "$value": "{font.line.body-large}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "bg": { "$type": "color", "$value": "{color.bg.card}" },
    "border": { "$type": "color", "$value": "{color.stroke.card}" },
    "header-fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "header-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "header-bg-active": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "header-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "chevron-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo-inset}" }
  }
}
