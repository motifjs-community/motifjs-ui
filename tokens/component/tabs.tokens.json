{
  "tabs": {
    "$description": "Tabs: the strip of tabs and the panel under it, sized by the density tokens.",
    "gap": { "$type": "dimension", "$value": "{control.gap}" },
    "tab-gap": { "$type": "dimension", "$value": "{space.1}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "divider-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "indicator-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "strip-padding": { "$type": "dimension", "$value": "{space.1}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "badge-height": { "$type": "dimension", "$value": "{icon.size.md}" },
    "badge-padding": { "$type": "dimension", "$value": "{space.1}" },
    "badge-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "close-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "close-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "scroll-size": { "$type": "dimension", "$value": "{control.height.sm}" },
    "panel-padding": { "$type": "dimension", "$value": "{space.4}" },
    "vertical-width": { "$type": "dimension", "$value": { "value": 10, "unit": "rem" } },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "line-height": {
      "$type": "dimension",
      "sm": { "$value": "{font.line.caption}" },
      "md": { "$value": "{font.line.body}" },
      "lg": { "$value": "{font.line.body-large}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "divider": { "$type": "color", "$value": "{color.stroke.divider}" },
    "scroll-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "scroll-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "scroll-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "scroll-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "tab-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "tab-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "tab-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "tab-fg-selected": { "$type": "color", "$value": "{color.fg.primary}" },
    "tab-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "badge-fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "badge-bg": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "badge-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "close-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "close-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "close-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "indicator-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "indicator-color": { "$type": "color", "$value": "{color.accent.solid}" },
    "indicator-color-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "tray-bg": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "pill-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "pill-selected-bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "pill-selected-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "pill-selected-edge": { "$type": "color", "$value": "{color.stroke.control.edge}" },
    "pill-selected-edge-width": { "$type": "dimension", "$value": "{control.edge.width}" },
    "pill-selected-badge-fg": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "pill-selected-badge-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo-inset}" }
  }
}
