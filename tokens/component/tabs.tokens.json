{
  "tabs": {
    "$description": "Tabs: the strip of tabs and the panel under it, sized by the density tokens.",
    "gap": { "$type": "dimension", "$value": "{control.gap}" },
    "tab-gap": { "$type": "dimension", "$value": "{space.1}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "divider-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "indicator-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "strip-padding": { "$type": "dimension", "$value": "{space.1}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "badge-height": { "$type": "dimension", "$value": "{icon.size.md}" },
    "badge-padding": { "$type": "dimension", "$value": "{space.1}" },
    "badge-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "close-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "close-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "scroll-size": { "$type": "dimension", "$value": "{control.height.sm}" },
    "panel-padding": { "$type": "dimension", "$value": "{space.4}" },
    "vertical-width": { "$type": "dimension", "$value": { "value": 10, "unit": "rem" } },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    }
  }
}
