{
  "field": {
    "$description": "Field: the box of the text-like editors, with its label and the line under it.",
    "width": { "$type": "dimension", "$value": { "value": 16, "unit": "rem" } },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "focus-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "label-gap": { "$type": "dimension", "$value": "{space.1}" },
    "label-width": { "$type": "dimension", "$value": { "value": 8, "unit": "rem" } },
    "label-font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "message-gap": { "$type": "dimension", "$value": "{space.1}" },
    "message-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "message-line": { "$type": "dimension", "$value": "{font.line.caption}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "button-inset": { "$type": "dimension", "$value": "{space.1}" },
    "button-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "floating-height": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "floating-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "bg-hover": { "$type": "color", "$value": "{color.fill.control.secondary}" },
    "bg-focus": { "$type": "color", "$value": "{color.bg.surface}" },
    "border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "edge": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "edge-focus": { "$type": "color", "$value": "{color.accent.solid}" },
    "filled-bg": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "filled-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "invalid-border": { "$type": "color", "$value": "{color.danger.solid}" },
    "readonly-edge": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "readonly-edge-focus": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "disabled-fg": { "$type": "color", "$value": "{color.fg.disabled}" },
    "disabled-bg": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "disabled-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "required-gap": { "$type": "dimension", "$value": "{space.1}" },
    "required-fg": { "$type": "color", "$value": "{color.danger.fg}" },
    "placeholder": { "$type": "color", "$value": "{color.fg.secondary}" },
    "floating-label-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "floating-label-font-weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
    "floating-padding": { "$type": "dimension", "$value": "{space.2}" },
    "icon-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "affix-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "tools-gap": { "$type": "dimension", "$value": "{space.1}" },
    "button-gap": { "$type": "dimension", "$value": "{space.1}" },
    "button-padding": { "$type": "dimension", "$value": "{space.1}" },
    "button-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "button-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "button-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "button-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "button-bg-active": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "message-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "error-fg": { "$type": "color", "$value": "{color.danger.fg}" }
  }
}
