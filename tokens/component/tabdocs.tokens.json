{
  "tabdocs": {
    "$description": "TabDocumentManager: groups of documents in tabs, splitters between the groups.",
    "bg": { "$type": "color", "$value": "{color.bg.layer}" },
    "group-bg": { "$type": "color", "$value": "{color.bg.card}" },
    "bar-bg": { "$type": "color", "$value": "{color.bg.bar}" },
    "bar-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "bar-border-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "tab-height": { "$type": "dimension", "$value": "{control.height.md}" },
    "tab-padding": { "$type": "dimension", "$value": "{control.padding.sm}" },
    "tab-gap": { "$type": "dimension", "$value": "{control.gap}" },
    "tab-font-size": { "$type": "dimension", "$value": "{font.size.body}" },
    "tab-line-height": { "$type": "dimension", "$value": "{font.line.body}" },
    "tab-font-weight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
    "tab-title-max-width": { "$type": "dimension", "$value": { "value": 16, "unit": "rem" } },
    "tab-separator-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "tab-separator-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "tab-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "tab-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "tab-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "tab-fg-active": { "$type": "color", "$value": "{color.fg.primary}" },
    "tab-bg-active": { "$type": "color", "$value": "{color.bg.card}" },
    "indicator-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "indicator-color": { "$type": "color", "$value": "{color.accent.solid}" },
    "indicator-color-inactive": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "description-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "description-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "close-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "close-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "close-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "close-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "close-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "dirty-size": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "dirty-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "dirty-color": { "$type": "color", "$value": "{color.fg.primary}" },
    "badge-height": { "$type": "dimension", "$value": "{icon.size.md}" },
    "badge-padding": { "$type": "dimension", "$value": "{space.1}" },
    "badge-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "badge-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "badge-fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "badge-bg": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "actions-padding": { "$type": "dimension", "$value": "{space.1}" },
    "empty-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "empty-font-size": { "$type": "dimension", "$value": "{font.size.body}" },
    "empty-padding": { "$type": "dimension", "$value": "{space.4}" },
    "sash-size": { "$type": "dimension", "$value": "{space.1}" },
    "sash-line-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "sash-line-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "sash-active-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "sash-active-color": { "$type": "color", "$value": "{color.accent.solid}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo-inset}" }
  }
}
