{
  "listbox": {
    "$description": "ListBox: the list in the field's box, its check boxes and its search box.",
    "padding": { "$type": "dimension", "$value": "{space.1}" },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "check-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "check-radius": { "$type": "dimension", "$value": "{radius.xs}" },
    "check-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "divider-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "check-bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "check-border": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "check-bg-disabled": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "check-border-disabled": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "checked-mark": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "checked-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-border": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-mark-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "checked-bg-disabled": { "$type": "color", "$value": "{color.fill.accent-disabled}" },
    "select-all-font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "divider": { "$type": "color", "$value": "{color.stroke.divider}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" }
  }
}
