{
  "menubar": {
    "$description": "MenuBar: a bar of menus at the top of an app or a window.",
    "height": { "$type": "dimension", "$value": "{bar.height}" },
    "padding": { "$type": "dimension", "$value": "{space.1}" },
    "gap": { "$type": "dimension", "$value": "{space.0}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "background": { "$type": "color", "$value": "{color.bg.bar}" },
    "item-height": { "$type": "dimension", "$value": "{control.height.md}" },
    "item-padding": { "$type": "dimension", "$value": "{control.padding.md}" },
    "item-gap": { "$type": "dimension", "$value": "{control.gap}" },
    "item-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "item-highlight": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "item-open": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" }
  }
}
