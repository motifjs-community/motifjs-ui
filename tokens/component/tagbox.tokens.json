{
  "tagbox": {
    "$description": "TagBox: the tags in the field's box and the text input after them.",
    "inset": { "$type": "dimension", "$value": "{space.1}" },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "input-min-width": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } },
    "tag-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "tag-padding": { "$type": "dimension", "$value": "{space.2}" },
    "tag-gap": { "$type": "dimension", "$value": "{space.1}" },
    "tag-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "tag-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "tag-max-width": { "$type": "dimension", "$value": { "value": 12, "unit": "rem" } },
    "tag-bg": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "tag-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "tag-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "remove-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "tag-fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "tag-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "loading-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "more-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "remove-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "remove-fg-hover": { "$type": "color", "$value": "{color.fg.primary}" },
    "remove-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "remove-radius": { "$type": "dimension", "$value": "{radius.full}" }
  }
}
