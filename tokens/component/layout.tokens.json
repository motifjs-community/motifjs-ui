{
  "layout": {
    "$description": "Layout containers: the spacing steps of gap and padding, the default gap, panels, group boxes and the splitter.",
    "space": {
      "$type": "dimension",
      "xxs": { "$value": "{space.1}" },
      "xs": { "$value": "{space.2}" },
      "sm": { "$value": "{space.3}" },
      "md": { "$value": "{space.4}" },
      "lg": { "$value": "{space.6}" },
      "xl": { "$value": "{space.8}" },
      "xxl": { "$value": "{space.12}" }
    },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "panel": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "border-width": { "$type": "dimension", "$value": "{border.width.1}" }
    },
    "group-box": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
      "padding": { "$type": "dimension", "$value": "{space.4}" },
      "gap": { "$type": "dimension", "$value": "{space.3}" },
      "legend-padding": { "$type": "dimension", "$value": "{space.1}" },
      "font-size": { "$type": "dimension", "$value": "{font.size.body}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
    },
    "splitter": {
      "size": { "$type": "dimension", "$value": "{space.2}" },
      "line-width": { "$type": "dimension", "$value": "{border.width.1}" },
      "active-width": { "$type": "dimension", "$value": "{border.width.2}" },
      "grip-length": { "$type": "dimension", "$value": "{space.6}" },
      "grip-thickness": { "$type": "dimension", "$value": "{space.1}" }
    }
  }
}
