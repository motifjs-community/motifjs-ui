{
  "layout": {
    "$description": "Layout containers: the spacing steps of gap and padding, the default gap, panels, group boxes and the splitter.",
    "space": {
      "$type": "dimension",
      "xxs": { "$value": "{space.1}" },
      "xs": { "$value": "{space.2}" },
      "sm": { "$value": "{space.3}" },
      "md": { "$value": "{space.4}" },
      "lg": { "$value": "{space.6}" },
      "xl": { "$value": "{space.8}" },
      "xxl": { "$value": "{space.12}" }
    },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "panel": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
      "border": { "$type": "color", "$value": "{color.stroke.card}" },
      "bg": { "$type": "color", "$value": "{color.bg.card}" },
      "shadow": { "$type": "shadow", "$value": "{elevation.card}" }
    },
    "group-box": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
      "padding": { "$type": "dimension", "$value": "{space.4}" },
      "gap": { "$type": "dimension", "$value": "{space.3}" },
      "legend-padding": { "$type": "dimension", "$value": "{space.1}" },
      "font-size": { "$type": "dimension", "$value": "{font.size.body}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "fg": { "$type": "color", "$value": "{color.fg.primary}" },
      "border": { "$type": "color", "$value": "{color.stroke.card}" },
      "line-height": { "$type": "dimension", "$value": "{font.line.body}" },
      "legend-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
      "toggle-gap": { "$type": "dimension", "$value": "{control.gap}" },
      "toggle-radius": { "$type": "dimension", "$value": "{radius.sm}" },
      "toggle-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
      "toggle-bg-active": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
      "chevron-fg": { "$type": "color", "$value": "{color.fg.secondary}" }
    },
    "splitter": {
      "size": { "$type": "dimension", "$value": "{space.2}" },
      "line-width": { "$type": "dimension", "$value": "{border.width.1}" },
      "active-width": { "$type": "dimension", "$value": "{border.width.2}" },
      "grip-length": { "$type": "dimension", "$value": "{space.6}" },
      "grip-thickness": { "$type": "dimension", "$value": "{space.1}" },
      "line-color": { "$type": "color", "$value": "{color.stroke.divider}" },
      "grip-color": { "$type": "color", "$value": "{color.stroke.control.strong}" },
      "grip-radius": { "$type": "dimension", "$value": "{radius.full}" },
      "active-color": { "$type": "color", "$value": "{color.accent.solid}" },
      "grip-color-disabled": { "$type": "color", "$value": "{color.stroke.control.default}" }
    }
  }
}
