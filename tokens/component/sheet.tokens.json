{
  "sheet": {
    "$description": "BottomSheet (and the ActionSheet on it): a panel that comes up from the bottom, with a handle, a title and its content.",
    "background": { "$type": "color", "$value": "{color.bg.surface}" },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "border-color": { "$type": "color", "$value": "{color.stroke.surface}" },
    "radius": { "$type": "dimension", "$value": "{radius.xl}" },
    "shadow": { "$type": "shadow", "$value": "{elevation.dialog}" },
    "scrim": { "$type": "color", "$value": "{color.bg.smoke}" },
    "max-width": { "$type": "dimension", "$value": { "value": 40, "unit": "rem" } },
    "top-gap": { "$type": "dimension", "$value": "{space.10}" },
    "peek-height": { "$type": "dimension", "$value": { "value": 6, "unit": "rem" } },
    "padding": { "$type": "dimension", "$value": "{space.4}" },
    "header-gap": { "$type": "dimension", "$value": "{space.2}" },
    "header-padding": { "$type": "dimension", "$value": "{space.2}" },
    "footer-padding": { "$type": "dimension", "$value": "{space.3}" },
    "footer-gap": { "$type": "dimension", "$value": "{space.2}" },
    "footer-border-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "handle-area": { "$type": "dimension", "$value": "{space.6}" },
    "grip-width": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "grip-height": { "$type": "dimension", "$value": "{space.1}" },
    "grip-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "grip-color": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "handle-radius": { "$type": "dimension", "$value": "{radius.md}" },
    "font-family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.body}" },
    "line-height": { "$type": "dimension", "$value": "{font.line.body}" },
    "title-font-size": { "$type": "dimension", "$value": "{font.size.subtitle}" },
    "title-font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
    "title-line-height": { "$type": "dimension", "$value": "{font.line.subtitle}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo}" }
  }
}
