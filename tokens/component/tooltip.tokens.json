{
  "tooltip": {
    "$description": "Tooltip: a short description next to the element it describes.",
    "offset": { "$type": "dimension", "$value": "{space.1}" },
    "padding-block": { "$type": "dimension", "$value": "{space.1}" },
    "padding-inline": { "$type": "dimension", "$value": "{space.2}" },
    "max-width": { "$type": "dimension", "$value": { "value": 20, "unit": "rem" } },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "background": { "$type": "color", "$value": "{color.bg.surface}" },
    "border-color": { "$type": "color", "$value": "{color.stroke.surface}" },
    "shadow": { "$type": "shadow", "$value": "{shadow.8}" }
  }
}
