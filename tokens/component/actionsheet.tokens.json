{
  "actionsheet": {
    "$description": "ActionSheet: menu items in a bottom sheet, large enough for a finger, with a cancel button apart.",
    "item-height": { "$type": "dimension", "$value": "{control.height.lg}" },
    "item-padding": { "$type": "dimension", "$value": "{space.4}" },
    "item-gap": { "$type": "dimension", "$value": "{space.3}" },
    "item-font-size": { "$type": "dimension", "$value": "{font.size.body-large}" },
    "item-line-height": { "$type": "dimension", "$value": "{font.line.body-large}" },
    "item-radius": { "$type": "dimension", "$value": "{radius.md}" },
    "message-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "message-font-size": { "$type": "dimension", "$value": "{font.size.body}" },
    "message-line-height": { "$type": "dimension", "$value": "{font.line.body}" },
    "message-padding": { "$type": "dimension", "$value": "{space.4}" },
    "list-padding": { "$type": "dimension", "$value": "{space.2}" },
    "cancel-padding": { "$type": "dimension", "$value": "{space.2}" },
    "cancel-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "cancel-border-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "cancel-height": { "$type": "dimension", "$value": "{control.height.lg}" },
    "cancel-font-size": { "$type": "dimension", "$value": "{font.size.body-large}" },
    "cancel-font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
  }
}
