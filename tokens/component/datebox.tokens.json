{
  "date-box": {
    "$description": "DateBox: the list of times next to the calendar.",
    "times-width": { "$type": "dimension", "$value": { "value": 6, "unit": "rem" } },
    "times-height": { "$type": "dimension", "$value": { "value": 18, "unit": "rem" } },
    "popup-gap": { "$type": "dimension", "$value": "{space.1}" },
    "times-padding": { "$type": "dimension", "$value": "{space.1}" },
    "divider-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "divider": { "$type": "color", "$value": "{color.stroke.divider}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo}" }
  }
}
