{
  "list": {
    "$description": "List: the options of a drop-down, a combo box or a list box.",
    "item-height": { "$type": "dimension", "$value": "{control.height.md}" },
    "item-padding": { "$type": "dimension", "$value": "{control.padding.md}" },
    "item-gap": { "$type": "dimension", "$value": "{control.gap}" },
    "item-radius": { "$type": "dimension", "$value": "{item.radius}" },
    "item-highlight": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "item-selected": { "$type": "color", "$value": "{color.selection.bg}" },
    "item-selected-text": { "$type": "color", "$value": "{color.selection.fg}" },
    "item-selected-border": { "$type": "color", "$value": "{color.selection.border}" },
    "item-selected-border-width": { "$type": "dimension", "$value": "{selection.border-width}" },
    "item-selected-effect": { "$type": "shadow", "$value": "{effect.selection}" },
    "indicator-width": { "$type": "dimension", "$value": "{indicator.thickness}" },
    "indicator-length": { "$type": "dimension", "$value": "{indicator.length}" },
    "indicator-radius": { "$type": "dimension", "$value": "{indicator.radius}" },
    "indicator-color": { "$type": "color", "$value": "{color.selection.indicator}" },
    "header-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "header-font-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
    "max-height": { "$type": "dimension", "$value": { "value": 20, "unit": "rem" } },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "item-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "header-padding": { "$type": "dimension", "$value": "{space.1}" },
    "header-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "empty-fg": { "$type": "color", "$value": "{color.fg.secondary}" }
  }
}
