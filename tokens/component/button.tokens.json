{
  "button": {
    "$description": "Button: the pressable look, sized by the density tokens.",
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "edge-width": { "$type": "dimension", "$value": "{control.edge.width}" },
    "press-offset": { "$type": "dimension", "$value": "{control.press.offset}" },
    "font-weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
    "gap": { "$type": "dimension", "$value": "{control.gap}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "arrow-padding": { "$type": "dimension", "$value": "{control.padding.sm}" },
    "spinner-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "spinner-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body}" }
    },
    "line-height": {
      "$type": "dimension",
      "sm": { "$value": "{font.line.caption}" },
      "md": { "$value": "{font.line.body}" },
      "lg": { "$value": "{font.line.body}" }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "bg-hover": { "$type": "color", "$value": "{color.fill.control.secondary}" },
    "bg-active": { "$type": "color", "$value": "{color.fill.control.tertiary}" },
    "bg-disabled": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "border-disabled": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "edge": { "$type": "color", "$value": "{color.stroke.control.edge}" },
    "divider": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "shadow": { "$type": "shadow", "$value": "{effect.control}" },
    "text": { "$type": "color", "$value": "{color.fg.primary}" },
    "accent-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "accent-bg-hover": { "$type": "color", "$value": "{color.accent.solid-hover}" },
    "accent-bg-active": { "$type": "color", "$value": "{color.accent.solid-pressed}" },
    "accent-fg": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "accent-text": { "$type": "color", "$value": "{color.accent.fg}" },
    "danger-bg": { "$type": "color", "$value": "{color.danger.solid}" },
    "danger-bg-hover": { "$type": "color", "$value": "{color.danger.solid-hover}" },
    "danger-bg-active": { "$type": "color", "$value": "{color.danger.solid-hover}" },
    "danger-fg": { "$type": "color", "$value": "{color.danger.on-solid}" },
    "danger-text": { "$type": "color", "$value": "{color.danger.fg}" },
    "solid-edge": { "$type": "color", "$value": "{color.stroke.on-accent-bottom}" },
    "solid-bg-disabled": { "$type": "color", "$value": "{color.fill.accent-disabled}" },
    "solid-fg-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "subtle-bg-hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "subtle-bg-active": { "$type": "color", "$value": "{color.fill.subtle.tertiary}" },
    "outline-border": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo}" }
  }
}
