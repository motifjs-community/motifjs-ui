{
  "treeview": {
    "$description": "TreeView: rows of a hierarchy, sized by the density tokens, indented per level.",
    "row-height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "indent": {
      "$type": "dimension",
      "sm": { "$value": "{space.4}" },
      "md": { "$value": "{space.5}" },
      "lg": { "$value": "{space.6}" }
    },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "selected": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "indicator-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "indicator-color": { "$type": "color", "$value": "{color.accent.fg}" },
    "expander-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "check-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "check-mark-size": { "$type": "dimension", "$value": "{icon.size.sm}" },
    "check-radius": { "$type": "dimension", "$value": "{radius.xs}" },
    "line-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "line-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "search-gap": { "$type": "dimension", "$value": "{space.2}" }
  }
}
