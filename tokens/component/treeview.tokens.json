{
  "treeview": {
    "$description": "TreeView: rows of a hierarchy, sized by the density tokens, indented per level.",
    "line-height": {
      "$type": "dimension",
      "sm": { "$value": "{font.line.caption}" },
      "md": { "$value": "{font.line.body}" },
      "lg": { "$value": "{font.line.body-large}" }
    },
    "row-height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{control.padding.sm}" },
      "md": { "$value": "{control.padding.md}" },
      "lg": { "$value": "{control.padding.lg}" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "indent": {
      "$type": "dimension",
      "sm": { "$value": "{space.4}" },
      "md": { "$value": "{space.5}" },
      "lg": { "$value": "{space.6}" }
    },
    "gap": { "$type": "dimension", "$value": "{space.1}" },
    "radius": { "$type": "dimension", "$value": "{item.radius}" },
    "hover": { "$type": "color", "$value": "{color.fill.subtle.secondary}" },
    "selected": { "$type": "color", "$value": "{color.selection.bg}" },
    "selected-text": { "$type": "color", "$value": "{color.selection.fg}" },
    "selected-border": { "$type": "color", "$value": "{color.selection.border}" },
    "selected-border-width": { "$type": "dimension", "$value": "{selection.border-width}" },
    "selected-effect": { "$type": "shadow", "$value": "{effect.selection}" },
    "indicator-width": { "$type": "dimension", "$value": "{indicator.thickness}" },
    "indicator-length": { "$type": "dimension", "$value": "{indicator.length}" },
    "indicator-radius": { "$type": "dimension", "$value": "{indicator.radius}" },
    "indicator-color": { "$type": "color", "$value": "{color.selection.indicator}" },
    "expander-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "icon-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "check-size": { "$type": "dimension", "$value": "{icon.size.md}" },
    "check-mark-size": { "$type": "dimension", "$value": "{icon.size.sm}" },
    "check-radius": { "$type": "dimension", "$value": "{radius.xs}" },
    "line-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "line-color": { "$type": "color", "$value": "{color.stroke.divider}" },
    "search-gap": { "$type": "dimension", "$value": "{space.2}" },
    "fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "empty-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "row-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "expander-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "spinner-size": { "$type": "dimension", "$value": "{icon.size.sm}" },
    "spinner-width": { "$type": "dimension", "$value": "{border.width.2}" },
    "spinner-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "check-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "check-edge-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "check-shadow": { "$type": "shadow", "$value": "{effect.control}" },
    "check-bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "check-bg-hover": { "$type": "color", "$value": "{color.fill.control.secondary}" },
    "check-border": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "check-edge": { "$type": "color", "$value": "{color.stroke.control.edge}" },
    "check-mark": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "checked-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-bg-hover": { "$type": "color", "$value": "{color.accent.solid-hover}" },
    "checked-border": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-edge": { "$type": "color", "$value": "{color.stroke.on-accent-bottom}" },
    "check-bg-disabled": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "check-border-disabled": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "check-mark-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "checked-bg-disabled": { "$type": "color", "$value": "{color.fill.accent-disabled}" },
    "error-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "error-fg": { "$type": "color", "$value": "{color.danger.fg}" },
    "retry-padding": { "$type": "dimension", "$value": "{space.1}" },
    "retry-fg": { "$type": "color", "$value": "{color.accent.fg}" },
    "retry-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo-inset}" }
  }
}
