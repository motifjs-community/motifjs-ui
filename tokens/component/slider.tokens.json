{
  "slider": {
    "$description": "Slider: the rail, the thumbs, the ticks and the value bubble.",
    "hit-size": { "$type": "dimension", "$value": "{control.height.lg}" },
    "vertical-length": { "$type": "dimension", "$value": { "value": 10, "unit": "rem" } },
    "rail-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "thumb-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "thumb-edge-width": { "$type": "dimension", "$value": "{control.edge.width}" },
    "tick-length": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } },
    "tick-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "tick-gap": { "$type": "dimension", "$value": "{space.1}" },
    "tick-label-width": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
    "tick-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "bubble-gap": { "$type": "dimension", "$value": "{space.2}" },
    "bubble-padding-block": { "$type": "dimension", "$value": "{space.1}" },
    "bubble-padding-inline": { "$type": "dimension", "$value": "{space.2}" },
    "bubble-radius": { "$type": "dimension", "$value": "{radius.sm}" },
    "bubble-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "bubble-shadow": { "$type": "shadow", "$value": "{shadow.4}" },
    "rail-thickness": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.1875, "unit": "rem" } },
      "md": { "$value": { "value": 0.25, "unit": "rem" } },
      "lg": { "$value": { "value": 0.375, "unit": "rem" } }
    },
    "thumb-size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 1, "unit": "rem" } },
      "md": { "$value": { "value": 1.25, "unit": "rem" } },
      "lg": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "dot-size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.375, "unit": "rem" } },
      "md": { "$value": { "value": 0.5, "unit": "rem" } },
      "lg": { "$value": { "value": 0.625, "unit": "rem" } }
    },
    "rail-color": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "fill-color": { "$type": "color", "$value": "{color.accent.solid}" },
    "readonly-fill-color": { "$type": "color", "$value": "{color.fg.secondary}" },
    "disabled-rail-color": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "disabled-fill-color": { "$type": "color", "$value": "{color.fg.disabled}" },
    "thumb-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "thumb-bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "thumb-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "thumb-edge": { "$type": "color", "$value": "{color.stroke.control.edge}" },
    "thumb-shadow": { "$type": "shadow", "$value": "{effect.control}" },
    "thumb-bg-disabled": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "thumb-border-disabled": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "dot-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "bubble-line-height": { "$type": "dimension", "$value": "{font.line.caption}" },
    "bubble-fg": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "bubble-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "tick-color": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "tick-line-height": { "$type": "dimension", "$value": "{font.line.caption}" },
    "tick-label-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "tick-label-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo}" }
  }
}
