{
  "form-layout": {
    "$description": "FormLayout: the gaps between fields and the look of groups.",
    "row-gap": { "$type": "dimension", "$value": "{space.4}" },
    "column-gap": { "$type": "dimension", "$value": "{space.4}" },
    "group-padding": { "$type": "dimension", "$value": "{space.4}" },
    "group-radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "caption-weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
    "group-border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "group-border": { "$type": "color", "$value": "{color.stroke.divider}" },
    "caption-padding": { "$type": "dimension", "$value": "{space.1}" }
  }
}
