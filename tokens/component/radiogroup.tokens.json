{
  "radiogroup": {
    "$description": "RadioGroup: the circles, their dot, the option texts and how the options are laid out.",
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "column-gap": { "$type": "dimension", "$value": "{space.6}" },
    "help-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "help-line": { "$type": "dimension", "$value": "{font.line.caption}" },
    "size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": "{icon.size.md}" },
      "lg": { "$value": "{icon.size.lg}" }
    },
    "dot-size": {
      "$type": "dimension",
      "sm": { "$value": { "value": 0.375, "unit": "rem" } },
      "md": { "$value": { "value": 0.4375, "unit": "rem" } },
      "lg": { "$value": { "value": 0.5625, "unit": "rem" } }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "radius": { "$type": "dimension", "$value": "{radius.full}" },
    "edge-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "press-offset": { "$type": "dimension", "$value": "{control.press.offset}" },
    "shadow": { "$type": "shadow", "$value": "{effect.control}" },
    "bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "bg-hover": { "$type": "color", "$value": "{color.fill.control.secondary}" },
    "bg-active": { "$type": "color", "$value": "{color.fill.control.tertiary}" },
    "border": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "edge": { "$type": "color", "$value": "{color.stroke.control.edge}" },
    "invalid-border": { "$type": "color", "$value": "{color.danger.solid}" },
    "checked-dot": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "checked-border": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-border-hover": { "$type": "color", "$value": "{color.accent.solid-hover}" },
    "disabled-bg": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "disabled-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "checked-dot-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "checked-border-disabled": { "$type": "color", "$value": "{color.fill.accent-disabled}" },
    "text-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" },
    "help-gap": { "$type": "dimension", "$value": "{space.1}" },
    "help-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "focus-width": { "$type": "dimension", "$value": "{focus.ring.width}" },
    "focus-offset": { "$type": "dimension", "$value": "{focus.ring.offset}" },
    "focus-color": { "$type": "color", "$value": "{focus.ring.color}" },
    "focus-halo": { "$type": "shadow", "$value": "{focus.ring.halo}" }
  }
}
