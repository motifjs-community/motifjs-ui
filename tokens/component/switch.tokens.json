{
  "switch": {
    "$description": "Switch: a track with a thumb that slides, and the on / off texts.",
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "thumb-inset": { "$type": "dimension", "$value": "{space.1}" },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "text-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "text-padding": { "$type": "dimension", "$value": "{space.2}" },
    "track-width": {
      "$type": "dimension",
      "sm": { "$value": { "value": 2, "unit": "rem" } },
      "md": { "$value": { "value": 2.5, "unit": "rem" } },
      "lg": { "$value": { "value": 3, "unit": "rem" } }
    },
    "track-height": {
      "$type": "dimension",
      "sm": { "$value": { "value": 1, "unit": "rem" } },
      "md": { "$value": { "value": 1.25, "unit": "rem" } },
      "lg": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    },
    "track-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "thumb-radius": { "$type": "dimension", "$value": "{radius.full}" },
    "bg": { "$type": "color", "$value": "{color.fill.control.default}" },
    "bg-hover": { "$type": "color", "$value": "{color.fill.control.secondary}" },
    "border": { "$type": "color", "$value": "{color.stroke.control.strong}" },
    "thumb": { "$type": "color", "$value": "{color.fg.secondary}" },
    "text-fg": { "$type": "color", "$value": "{color.fg.secondary}" },
    "checked-bg": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-bg-hover": { "$type": "color", "$value": "{color.accent.solid-hover}" },
    "checked-border": { "$type": "color", "$value": "{color.accent.solid}" },
    "checked-thumb": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "checked-text-fg": { "$type": "color", "$value": "{color.accent.on-solid}" },
    "invalid-border": { "$type": "color", "$value": "{color.danger.solid}" },
    "disabled-bg": { "$type": "color", "$value": "{color.fill.control.disabled}" },
    "disabled-border": { "$type": "color", "$value": "{color.stroke.control.default}" },
    "disabled-thumb": { "$type": "color", "$value": "{color.fg.disabled}" },
    "disabled-text-fg": { "$type": "color", "$value": "{color.fg.disabled}" },
    "checked-bg-disabled": { "$type": "color", "$value": "{color.fill.accent-disabled}" },
    "checked-thumb-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "checked-text-fg-disabled": { "$type": "color", "$value": "{color.fg.on-accent-disabled}" },
    "label-fg": { "$type": "color", "$value": "{color.fg.primary}" },
    "label-fg-disabled": { "$type": "color", "$value": "{color.fg.disabled}" }
  }
}
