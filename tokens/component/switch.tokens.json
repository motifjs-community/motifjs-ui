{
  "switch": {
    "$description": "Switch: a track with a thumb that slides, and the on / off texts.",
    "border-width": { "$type": "dimension", "$value": "{border.width.1}" },
    "thumb-inset": { "$type": "dimension", "$value": "{space.1}" },
    "gap": { "$type": "dimension", "$value": "{space.2}" },
    "text-font-size": { "$type": "dimension", "$value": "{font.size.caption}" },
    "text-padding": { "$type": "dimension", "$value": "{space.2}" },
    "track-width": {
      "$type": "dimension",
      "sm": { "$value": { "value": 2, "unit": "rem" } },
      "md": { "$value": { "value": 2.5, "unit": "rem" } },
      "lg": { "$value": { "value": 3, "unit": "rem" } }
    },
    "track-height": {
      "$type": "dimension",
      "sm": { "$value": { "value": 1, "unit": "rem" } },
      "md": { "$value": { "value": 1.25, "unit": "rem" } },
      "lg": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "height": {
      "$type": "dimension",
      "sm": { "$value": "{control.height.sm}" },
      "md": { "$value": "{control.height.md}" },
      "lg": { "$value": "{control.height.lg}" }
    },
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{font.size.caption}" },
      "md": { "$value": "{font.size.body}" },
      "lg": { "$value": "{font.size.body-large}" }
    }
  }
}
