{
  "radiogroup": {
    "$description": "Lilac radios: 18 px at the medium size, with a dot to match, and more room before the text.",
    "gap": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      }
    },
    "dot-size": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.4375,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 0.5625,
          "unit": "rem"
        }
      }
    }
  }
}
