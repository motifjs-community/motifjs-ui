{
  "field": {
    "$description": "Material filled text fields: 4 corners on top and square below, 56 tall, 16 side space, 16 input text, 24 icons, a 3 focus line; round buttons inside.",
    "radius": {
      "$type": "dimension",
      "$value": "0.25rem 0.25rem 0 0"
    },
    "button-radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "focus-width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "icon-size": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "floating-height": {
      "$type": "dimension",
      "$value": "{control.height.lg}"
    },
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{control.height.lg}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{control.height.lg}"
      }
    },
    "padding": {
      "sm": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    },
    "font-size": {
      "sm": {
        "$type": "dimension",
        "$value": "{font.size.body}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{font.size.body-large}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{font.size.body-large}"
      }
    }
  }
}
