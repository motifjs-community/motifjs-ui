    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "icon-size": {
      "$type": "dimension",
      "$value": "{icon.size.lg}"
    },
    "padding": {
      "sm": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.6}"
      }
    },
    "font-size": {
      "sm": {
        "$type": "dimension",
        "$value": "{font.size.body}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{font.size.body}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{font.size.body-large}"
      }
    }
  }
}
