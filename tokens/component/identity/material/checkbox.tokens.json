{
  "checkbox": {
    "$description": "Material check boxes: 18 boxes with 2 corners and a 2 outline.",
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width.2}"
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      }
    }
  }
}
