{
  "radiogroup": {
    "$description": "Material radio buttons: 20 circles with a 2 outline and a 10 dot.",
    "border-width": {
      "$type": "dimension",
      "$value": "{border.width.2}"
    },
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      }
    },
    "dot-size": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.5,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 0.625,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      }
    }
  }
}
