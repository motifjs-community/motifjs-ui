{
  "accordion": {
    "$description": "Material expandable lists: items 56 tall with 16 side space.",
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{control.height.lg}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{control.height.lg}"
      }
