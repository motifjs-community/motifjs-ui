        "$type": "dimension",
        "$value": "{space.3}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    }
  }
}
