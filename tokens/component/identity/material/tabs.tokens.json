{
  "tabs": {
    "$description": "Material tabs: 48 tall (64 with an icon), 16 side space, a 3 active indicator; the tab itself is square (line tabs are drawn square anyway). The pill tabs and the scroll buttons take the full round shape of segmented and icon buttons.",
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "indicator-width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "rem"
        }
      }
    },
    "padding": {
      "sm": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    }
  }
}
