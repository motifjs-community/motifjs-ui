{
  "form": {
    "$description": "MxForm: the embedded form and its floating window.",
    "radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "padding": { "$type": "dimension", "$value": "{space.6}" },
    "width": { "$type": "dimension", "$value": { "value": 34, "unit": "rem" } },
    "min-width": { "$type": "dimension", "$value": { "value": 20, "unit": "rem" } },
    "min-height": { "$type": "dimension", "$value": { "value": 8, "unit": "rem" } },
    "minimized-width": { "$type": "dimension", "$value": { "value": 14, "unit": "rem" } },
    "resize-handle": { "$type": "dimension", "$value": "{space.2}" },
    "border": { "$type": "color", "$value": "{color.stroke.surface}" },
    "shadow": { "$type": "shadow", "$value": "{shadow.28}" },
    "shadow-modal": { "$type": "shadow", "$value": "{shadow.64}" },
    "shadow-minimized": { "$type": "shadow", "$value": "{shadow.4}" },
    "backdrop": { "$type": "color", "$value": "{color.bg.smoke}" },
    "body-bg": { "$type": "color", "$value": "{color.bg.surface}" },
    "footer-bg": { "$type": "color", "$value": "{color.bg.layer}" },
    "titlebar": {
      "bg": { "$type": "color", "$value": "{color.bg.bar}" },
      "height": { "$type": "dimension", "$value": "{bar.height}" },
      "gap": { "$type": "dimension", "$value": "{space.2}" },
      "padding-inline": { "$type": "dimension", "$value": "{space.4}" },
      "font-size": { "$type": "dimension", "$value": "{font.size.caption}" }
    },
    "caption-button": {
      "width": { "$type": "dimension", "$value": { "value": 2.875, "unit": "rem" } },
      "icon": { "$type": "dimension", "$value": { "value": 0.625, "unit": "rem" } },
      "close-hover-bg": { "$type": "color", "$value": "{color.danger.solid}" },
      "close-hover-fg": { "$type": "color", "$value": "{color.danger.on-solid}" }
    }
  }
}
